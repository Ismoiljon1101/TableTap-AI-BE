                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"email\": \"owner@test.com\",\n    \"password\": \"password123\",\n    \"nickname\": \"Owner\",\n    \"role\": \"owner\",\n    \"restaurantName\": \"My Restaurant\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/auth/register",
